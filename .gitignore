# --- FastF1 cache and raw data (rule 10: F1 data is not redistributed) ---
cache/
.fastf1_cache/
data/
*.ff1pkl
*.sqlite

# --- Python build / bytecode ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Test and tooling caches ---
.pytest_cache/
.coverage
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Editors / OS ---
.vscode/
.idea/
Thumbs.db
.DS_Store

# Run-specific pipeline log (contains local cache paths)
reports/pipeline.log

# Coverage HTML (regenerated by the test-report command, D85)
reports/coverage/

# Benchmark timings of the latest pipeline run (machine-dependent, D91)
reports/benchmarks_latest/
